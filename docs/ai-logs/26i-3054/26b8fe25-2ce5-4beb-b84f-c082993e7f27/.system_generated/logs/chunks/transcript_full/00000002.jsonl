mg:'https://images.unsplash.com/photo-1606664515524-ed2f786a0bd6?auto=format&fit=crop&w=1100&q=85'},\n12: {id:5,brand:'Lamborghini',model:'Huracán EVO',year:2024,price:114000000,engine:'5.2L V10',power:'631 HP',speed:'2.9 sec',type:'Supercar',tag:'Exclusive',img:'https://images.unsplash.com/photo-1544829099-b9a0c07fad1a?auto=format&fit=crop&w=1100&q=85'},\n13: {id:6,brand:'Range Rover',model:'Sport Autobiography',year:2025,price:56500000,engine:'3.0L Turbo',power:'395 HP',speed:'5.4 sec',type:'SUV',tag:'Luxury SUV',img:'https://images.unsplash.com/photo-1519641471654-76ce0107ad1b?auto=format&fit=crop&w=1100&q=85'},\n14: {id:7,brand:'Mercedes-Benz',model:'S-Class',year:2025,price:62500000,engine:'3.0L Hybrid',power:'442 HP',speed:'4.5 sec',type:'Sedan',tag:'Luxury',img:'https://images.unsplash.com/photo-1563720223185-11003d516935?auto=format&fit=crop&w=1100&q=85'},\n15: {id:8,brand:'BMW',model:'i8 Roadster',year:2024,price:36900000,engine:'Hybrid',power:'369 HP',speed:'4.4 sec',type:'Roadster',tag:'Collector',img:'https://images.unsplash.com/photo-1523983388277-336a66bf9bcd?auto=format&fit=crop&w=1100&q=85'}\n16: ];\n17: const get=(k,d)=>{try{return JSON.parse(localStorage.getItem('apex_'+k))??d}catch{return d}};\n18: const set=(k,v)=>localStorage.setItem('apex_'+k,JSON.stringify(v));\n19: const cars=()=>get('cars',seed),wish=()=>get('wish',[]),bookings=()=>get('bookings',[]);\n20: const car=id=>cars().find(x=>x.id===Number(id))||cars()[0];\n21: const toast=t=>{document.querySelector('.toast')?.remove();let el=document.createElement('div');el.className='toast';el.textContent=t;document.body.append(el);setTimeout(()=>el.remove(),2800)};\n22: const toggleWish=id=>{let a=wish();a=a.includes(id)?a.filter(x=>x!==id):[...a,id];set('wish',a);toast(a.includes(id)?'Added to saved cars':'Removed from saved cars');render()};\n23: const navLinks=[['index','Home'],['explore-cars','Explore Cars'],['brands','Brands'],['new-arrivals','New Arrivals'],['offers','Offers'],['about','About'],['contact','Contact']];\n24: const header=()=>`<div class=\"topbar\">THE ART OF AUTOMOTIVE EXCELLENCE · ISLAMABAD, PAKISTAN</div><header class=\"header\"><div class=\"wrap nav\"><a class=\"logo\" href=\"${href('index')}\">APEX<span>✦</span>MOTORS</a><nav class=\"navlinks\" id=\"navlinks\">${navLinks.map(([s,n])=>`<a class=\"${page===s?'active':''}\" href=\"${href(s)}\">${n}</a>`).join('')}<a href=\"${href('compare-cars')}\">Compare</a><a href=\"${href('finance-calculator')}\">Finance</a><a href=\"${href('test-drive')}\">Test Drive</a><a href=\"${href('saved-cars')}\">Saved Cars ♡</a><a href=\"${href('admin')}\">Admin</a></nav><div class=\"nav-actions\"><a class=\"btn small\" href=\"${href('test-drive')}\">Book a Test Drive ↗</a><button class=\"btn outline small menu-toggle\" aria-label=\"Toggle navigation\" onclick=\"document.getElementById('navlinks').classList.toggle('open')\">☰ Menu</button></div></div></header>`;\n25: const footer=()=>`<footer class=\"footer\"><div class=\"wrap\"><div class=\"footer-grid\"><div><div class=\"logo\">APEX<span>✦</span>MOTORS</div><p style=\"max-width:320px;margin-top:18px\">An elevated way to discover, compare and experience the world's most extraordinary automobiles.</p><div class=\"eyebrow\">DRIVE THE EXTRAORDINARY.</div></div><div><h4>Discover</h4>${[['explore-cars','Our Collection'],['brands','Our Brands'],['new-arrivals','New Arrivals'],['offers','Special Offers']].map(([s,n])=>`<a href=\"${href(s)}\">${n}</a>`).join('')}</div><div><h4>Services</h4>${[['compare-cars','Compare Cars'],['finance-calculator','Finance'],['test-drive','Test Drive'],['saved-cars','Wishlist']].map(([s,n])=>`<a href=\"${href(s)}\">${n}</a>`).join('')}</div><div><h4>Company</h4>${[['about','About Us'],['contact','Contact'],['faq','Help & FAQ'],['admin','Admin Portal']].map(([s,n])=>`<a href=\"${href(s)}\">${n}</a>`).join('')}</div></div><div class=\"footer-bottom\"><span>© 2026 APEX MOTORS. A luxury showroom concept website. Vehicle prices and availability are illustrative.</span><span>CRAFTED FOR THE EXTRAORDINARY</span></div></div></footer>`;\n26: const hero=(title,desc,kicker='APEX MOTORS / THE COLLECTION')=>`<section class=\"page-hero\"><div class=\"wrap\"><div class=\"eyebrow\">${kicker}</div><h1>${title}</h1><p>${desc}</p></div></section>`;\n27: const card=c=>`<article class=\"card\"><div class=\"card-image\"><a href=\"${href('car-details')}?id=${c.id}\"><img src=\"${c.img}\" alt=\"${c.brand} ${c.model}\" loading=\"lazy\"></a><span class=\"pill\">${c.tag||'Available'}</span></div><div class=\"card-body\"><div class=\"meta\">${c.brand.toUpperCase()} / ${c.year} / ${c.type}</div><h3>${c.model}</h3><div class=\"meta\">${c.engine} · ${c.power}</div><div class=\"card-bottom\"><div><div class=\"meta\">STARTING FROM</div><div class=\"price\">${money(c.price)}</div></div><button class=\"btn ghost small\" aria-label=\"Toggle saved car\" onclick=\"toggleWish(${c.id})\">${wish().includes(c.id)?'♥':'♡'}</button></div><div class=\"row\" style=\"margin-top:18px\"><a class=\"link\" href=\"${href('car-details')}?id=${c.id}\">View Details ↗</a><button class=\"btn outline small\" onclick=\"addCompare(${c.id})\">+ Compare</button></div></div></article>`;\n28: const cards=a=>a.length?`<div class=\"grid\">${a.map(card).join('')}</div>`:'<div class=\"empty\">No vehicles found. Try changing your filters.</div>';\n29: const section=(title,desc,body,alt=false)=>`<section class=\"section ${alt?'alt':''}\"><div class=\"wrap\"><div class=\"section-head\"><div><div class=\"eyebrow\">APEX MOTORS / CURATED FOR YOU</div><h2>${title}</h2></div><p>${desc}</p></div>${body}</div></section>`;\n30: const home=()=>`<section class=\"hero\"><div class=\"wrap hero-content\"><div class=\"eyebrow\">EST. 2026 · A NEW STANDARD OF LUXURY</div><h1>DRIVE THE<br><span class=\"gold\">EXTRAORDINARY.</span></h1><p>Exceptional machines. Unforgettable journeys. Discover a curated collection of the world's most desirable automobiles.</p><div class=\"hero-actions\"><a class=\"btn\" href=\"${href('explore-cars')}\">Explore Collection ↗</a><a class=\"btn outline\" href=\"${href('test-drive')}\">Book a Test Drive</a></div></div><div class=\"wrap hero-foot\"><span>01 / THE PURSUIT OF PERFECTION</span><span>SCROLL TO EXPLORE ↓</span></div></section><div class=\"wrap grid four\" style=\"margin-top:25px\">${[['08+','Curated Vehicles'],['06','Luxury Marques'],['100%','Passion Driven'],['24/7','Digital Showroom']].map(x=>`<div class=\"stat\"><strong>${x[0]}</strong><span>${x[1]}</span></div>`).join('')}</div>${section('Icons of Excellence','A handpicked selection of extraordinary performance, craftsmanship and design.',cards(cars().slice(0,3))+'<div class=\"text-center\" style=\"margin-top:35px\"><a class=\"btn outline\" href=\"'+href('explore-cars')+'\">Explore All Vehicles ↗</a></div>')}${section('The World’s Finest Marques','Explore the brands that define the very pinnacle of automotive engineering.',`<div class=\"grid four\">${['Porsche','Mercedes-Benz','BMW','Audi','Lamborghini','Range Rover'].map(b=>`<a class=\"brand-tile\" href=\"${href('brand-collection')}?brand=${encodeURIComponent(b)}\">${b}<div class=\"meta\" style=\"margin-top:12px\">EXPLORE ↗</div></a>`).join('')}</div>`,true)}<section class=\"banner\"><div class=\"wrap\"><div class=\"eyebrow\">YOUR NEXT CHAPTER BEGINS HERE</div><h2>THE ROAD IS CALLING.</h2><p style=\"max-width:460px\">Experience the difference behind the wheel. Schedule a private viewing or test drive today.</p><a class=\"btn\" href=\"${href('test-drive')}\">Reserve Your Experience ↗</a></div></section>${section('Why Choose APEX','Luxury is not only what you drive. It is how you feel at every step.',`<div class=\"grid\">${[['✧','Curated Excellence','A carefully selected collection of remarkable automobiles.'],['◇','Personalized Experience','Discover vehicles tailored to your preferences and lifestyle.'],['↗','Seamless Journey','Compare, calculate and schedule your experience with ease.']].map(x=>`<