 <button type=\"button\" class=\"btn btn-outline js-remove-wish\" data-id=\"${car.id}\" style=\"padding: 7px 12px; font-size: 0.8rem;\">Remove</button>\n382:             </div>\n383:           </div>\n384:         `\n385:         )\n386:         .join(\"\")}\n387:     </div>\n388:   `;\n389: \n390:   body.querySelectorAll(\".js-remove-wish\").forEach((btn) => {\n391:     btn.addEventListener(\"click\", () => {\n392:       toggleWishlistItem(btn.dataset.id);\n393:       renderWishlistModalBody();\n394:       document.dispatchEvent(new CustomEvent(\"carvault:wishlist-updated\", { detail: { carId: btn.dataset.id } }));\n395:     });\n396:   });\n397: }\n398: \n399: /* ==========================================================================\n400:    4-STATE TEST DRIVE BOOKING FLOW (Vertical Prototype Implementation)\n401:    State 1: Empty Form | State 2: Filled Form | State 3: Success | State 4: Failed Validation\n402:    ========================================================================== */\n403: let currentBookingDraft = {\n404:   carId: \"honda-civic\",\n405:   name: \"\",\n406:   phone: \"\",\n407:   email: \"\",\n408:   date: \"\",\n409:   time: \"\"\n410: };\n411: \n412: function openBookingModal(carId) {\n413:   ensureSharedModals();\n414:   const selectedCar = getCarById(carId);\n415:   // Reset to State 1 (Empty Form) whenever opened fresh"}
