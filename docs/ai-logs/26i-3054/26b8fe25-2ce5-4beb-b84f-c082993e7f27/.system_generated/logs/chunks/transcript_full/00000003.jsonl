      <option value=\"name-az\">Name: A to Z</option>\n          </select>\n        </div>\n\n        <button\n          type=\"button\"\n          id=\"mobileFilterToggle\"\n          class=\"btn btn-navy mobile-filter-toggle\"\n          aria-expanded=\"false\"\n          aria-controls=\"filtersSidebar\"\n        >\n          Filter Cars\n        </button>\n      </div>\n    </section>\n\n    <!-- Left Filters Sidebar + Right Car Grid -->\n    <section class=\"container\">\n      <div class=\"explore-layout\">\n        <aside id=\"filtersSidebar\" class=\"filters-sidebar\" aria-label=\"Car Filters\">\n          <h2 class=\"filters-title\">FILTERS</h2>\n\n          <div class=\"filter-group\">\n            <h3>Brand</h3>\n            <label class=\"filter-option\"><input type=\"checkbox\" name=\"brand\" value=\"Porsche\"> Porsche</label>\n            <label class=\"filter-option\"><input type=\"checkbox\" name=\"brand\" value=\"Mercedes-Benz\"> Mercedes-Benz</label>\n            <label class=\"filter-option\"><input type=\"checkbox\" name=\"brand\" value=\"BMW\"> BMW</label>\n            <label class=\"filter-option\"><input type=\"checkbox\" name=\"brand\" value=\"Audi\"> Audi</label>\n            <label class=\"filter-option\"><input type=\"checkbox\" name=\"brand\" value=\"Lamborghini\"> Lamborghini</label>\n            <label class=\"filter-option\"><input type=\"checkbox\" name=\"brand\" value=\"Range Rover\"> Range Rover</label>\n          </div>\n\n          <div class=\"filter-group\">\n            <h3>Price</h3>\n            <label class=\"filter-option\"><input type=\"checkbox\" name=\"price\" value=\"under-5cr\"> Under PKR 5 Cr</label>\n            <label class=\"filter-option\"><input type=\"checkbox\" name=\"price\" value=\"5cr-7cr\"> PKR 5 Cr &ndash; 7 Cr</label>\n            <label class=\"filter-option\"><input type=\"checkbox\" name=\"price\" value=\"7cr-plus\"> PKR 7 Cr &amp; above</label>\n          </div>\n\n          <div class=\"filter-group\">\n            <h3>Body Style</h3>\n            <label class=\"filter-option\"><input type=\"checkbox\" name=\"type\" value=\"Coupe\"> Coupe</label>\n            <label class=\"filter-option\"><input type=\"checkbox\" name=\"type\" value=\"Sedan\"> Sedan</label>\n            <label class=\"filter-option\"><input type=\"checkbox\" name=\"type\" value=\"SUV\"> SUV</label>\n            <label class=\"filter-option\"><input type=\"checkbox\" name=\"type\" value=\"Supercar\"> Supercar</label>\n            <label class=\"filter-option\"><input type=\"checkbox\" name=\"type\" value=\"Roadster\"> Roadster</label>\n            <label class=\"filter-option\"><input type=\"checkbox\" name=\"type\" value=\"Electric\"> Electric</label>\n          </div>","Target":"          <div class=\"search-input-wrap\">\n            <span class=\"search-icon\" aria-hidden=\"true\">&#128269;</span>\n            <input\n              type=\"search\"\n              id=\"searchInput\"\n              class=\"search-input\"\n              placeholder=\"Search for a car...\"\n              aria-label=\"Search for a car\"\n            >\n          </div>\n\n          <select id=\"sortSelect\" class=\"sort-select\" aria-label=\"Sort cars\">\n            <option value=\"default\">Sort: Featured</option>\n            <option value=\"price-low\">Price: Low to High</option>\n            <option value=\"price-high\">Price: High to Low</option>\n            <option value=\"name-az\">Name: A to Z</option>\n          </select>\n        </div>\n\n        <button\n          type=\"button\"\n          id=\"mobileFilterToggle\"\n          class=\"btn btn-navy mobile-filter-toggle\"\n          aria-expanded=\"false\"\n          aria-controls=\"filtersSidebar\"\n        >\n          Filter Cars\n        </button>\n      </div>\n    </section>\n\n    <!-- Left Filters Sidebar + Right Car Grid -->\n    <section class=\"container\">\n      <div class=\"explore-layout\">\n        <aside id=\"filtersSidebar\" class=\"filters-sidebar\" aria-label=\"Car Filters\">\n          <h2 class=\"filters-title\">FILTERS</h2>\n\n          <div class=\"filter-group\">\n            <h3>Brand</h3>\n            <label class=\"filter-option\"><input type=\"checkbox\" name=\"brand\" value=\"Toyota\"> Toyota</label>\n            <label class=\"filter-option\"><input type=\"checkbox\" name=\"brand\" value=\"Honda\"> Honda</label>\n            <label class=\"filter-option\"><input type=\"checkbox\" name=\"brand\" value=\"Kia\"> Kia</label>\n            <label class=\"filter-option\"><input type=\"checkbox\" name=\"brand\" value=\"Audi\"> Audi</label>\n            <label class=\"filter-option\"><input type=\"checkbox\" name=\"brand\" value=\"BMW\"> BMW</label>\n            <label class=\"filter-option\"><input type=\"checkbox\" name=\"brand\" value=\"Mercedes-Benz\"> Mercedes-Benz</label>\n          </div>\n\n          <div class=\"filter-group\">\n            <h3>Price</h3>\n            <label class=\"filter-option\"><input type=\"checkbox\" name=\"price\" value=\"10-50\"> Rs. 10 lac - 50 lac</label>\n            <label class=\"filter-option\"><input type=\"checkbox\" name=\"price\" value=\"50-100\"> Rs. 50 lac - 1 Cr</label>\n            <label class=\"filter-option\"><input type=\"checkbox\" name=\"price\" value=\"100-plus\"> Rs. 1 Cr &amp; above</label>\n          </div>\n\n          <div class=\"filter-group\">\n            <h3>Type</h3>\n            <label class=\"filter-option\"><input type=\"checkbox\" name=\"type\" value=\"Sedan\"> Sedan</label>\n            <label class=\"filter-option\"><input type=\"checkbox\" name=\"type\" value=\"SUV\"> SUV</label>\n            <label class=\"filter-option\"><input type=\"checkbox\" name=\"type\" value=\"Hatchback\"> Hatchback</label>\n            <label class=\"filter-option\"><input type=\"checkbox\" name=\"type\" value=\"Pickup truck\"> Pickup truck</label>\n          </div>"}},{"name":"write_file","args":{"Content":"/* ==========================================================================\n   CAR VAULT — Explore Cars Page Logic (js/explore.js)\n   Implements live search, brand/price/body-style filtering, sorting, and URL pre-filter.\n   ========================================================================== */\n\ndocument.addEventListener(\"DOMContentLoaded\", () => {\n  const searchInput = document.getElementById(\"searchInput\");\n  const sortSelect = document.getElementById(\"sortSelect\");\n  const applyFiltersBtn = document.getElementById(\"applyFiltersBtn\");\n  const resetFiltersBtn = document.getElementById(\"resetFiltersBtn\");\n  const mobileFilterToggle = document.getElementById(\"mobileFilterToggle\");\n  const filtersSidebar = document.getElementById(\"filtersSidebar\");\n\n  // Pre-select brand or search term if passed via URL (e.g., explore-cars.html?brand=Porsche)\n  const params = new URLSearchParams(window.location.search);\n  const initialBrand = params.get(\"brand\");\n  const initialSearch = params.get(\"search\");\n\n  if (initialBrand) {\n    const brandCheckbox = document.querySelector(`input[name=\"brand\"][value=\"${CSS.escape(initialBrand)}\"]`);\n    if (brandCheckbox) {\n      brandCheckbox.checked = true;\n    }\n  }\n\n  if (initialSearch && searchInput) {\n    searchInput.value = initialSearch;\n  }\n\n  // Mobile collapsible filter drawer\n  if (mobileFilterToggle && filtersSidebar) {\n    mobileFilterToggle.addEventListener(\"click\", () => {\n      const isOpen = filtersSidebar.classList.toggle(\"open\");\n      mobileFilterToggle.setAttribute(\"aria-expanded\", String(isOpen));\n      mobileFilterToggle.textContent = isOpen ? \"Hide Filters\" : \"Filter Cars\";\n    });\n  }\n\n  // Live search, sort & instant filter updates\n  if (searchInput) {\n    searchInput.addEventListener(\"input\", applySearchFiltersAndSort);\n  }\n  if (sortSelect) {\n    sortSelect.addEventListener(\"change\", applySearchFiltersAndSort);\n  }\n  document.querySelectorAll('#filtersSidebar input[type=\"checkbox\"]').forEach((box) => {\n    box.addEventListener(\"change\", applySearchFiltersAndSort);\n  });\n\n  // Apply button at bottom of Filter panel\n  if (applyFiltersBtn) {\n    applyFiltersBtn.addEventListener(\"click\", () => {\n      applySearchFiltersAndSort();\n      if (window.innerWidth <= 900 && filtersSidebar) {\n        filtersSidebar.classList.remove(\"open\");\n        mobileFilterToggle.setAttribute(\"aria-expanded\", \"false\");\n        mobileFilterToggle.textContent = \"Filter Cars\";\n      }\n    });\n  }\n\n  // Reset all filters & search\n  if (resetFiltersBtn) {\n    resetFiltersBtn.addEventListener(\"click\", resetAllFilters);\n  }\n\n  // Keep wishlist icons synced if updated from modal\n  document.addEventListener(\"carvault:wishlist-updated\", applySearchFiltersAndSort);\n\n  applySearchFiltersAndSort();\n});\n\nfunction getCheckedValues(name) {\n  return Array.from(document.querySelectorAll(`input[name=\"${name}\"]:checked`)).map((el) => el.value);\n}\n\nfunction matchesPriceRange(price, selectedRanges) {\n  if (selectedRanges.length === 0) return true;\n\n  return selectedRanges.some((range) => {\n    if (range === \"under-5cr\") return price < 50000000;\n    if (range === \"5cr-7cr\") return price >= 50000000 && price <= 70000000;\n    if (range === \"7cr-plus\") return price > 70000000;\n    return false;\n  });\n}\n\nfunction applySearchFiltersAndSort() {\n  const searchQuery = (document.getElementById(\"searchInput\")?.value || \"\").trim().toLowerCase();\n  const sortOrder = document.getElementById(\"sortSelect\")?.value || \"default\";\n  const selectedBrands = getCheckedValues(\"brand\");\n  const selectedPrices = getCheckedValues(\"price\");\n  const selectedTypes = getCheckedValues(\"type\");\n\n  let filteredCars = CAR_VAULT_CARS.filter((car) => {\n    const matchesSearch =\n      !searchQuery ||\n      car.model.toLowerCase().includes(searchQuery) ||\n      car.brand.toLowerCase().includes(searchQuery) ||\n      car.type.toLowerCase().includes(searchQuery) ||\n      car.engine.toLowerCase().includes(searchQuery);\n\n    const matchesBrand = selectedBrands.length === 0 || selectedBrands.includes(car.brand);\n    const matchesPrice = matchesPriceRange(car.price, selectedPrices);\n    const matchesType = selectedTypes.length === 0 || selectedTypes.includes(car.type);\n\n    return matchesSearch && matchesBrand && matchesPrice && matchesType;\n  });\n\n  if (sortOrder === \"price-low\") {\n    filteredCars = [...filteredCars].sort((a, b) => a.price - b.price);\n  } else if (sortOrder === \"price-high\") {\n    filteredCars = [...filteredCars].sort((a, b) => b.price - a.price);\n  } else if (sortOrder === \"newest\") {\n    filteredCars = [...filteredCars].sort((a, b) => b.year - a.year || a.price - b.price);\n  } else if (sortOrder === \"name-az\") {\n    filteredCars = [...filteredCars].sort((a, b) => a.model.localeCompare(b.model));\n  }\n\n  renderExploreResults(filteredCars);\n}\n\nfunction renderExploreResults(carsList) {\n  const grid = document.getElementById(\"exploreCarsGrid\");\n  const countLabel = document.getElementById(\"resultsCount\");\n  if (!grid || !countLabel) return;\n\n  countLabel.textContent = `Showing ${carsList.length} of ${CAR_VAULT_CARS.length} exceptional vehicles`;\n\n  if (carsList.length === 0) {\n    grid.innerHTML = `\n      <div class=\"empty-state\" style=\"grid-column: 1 / -1;\">\n        <h3>No vehicles found</h3>\n        <p>Try clearing some filters or searching for another make or model.</p>\n        <button type=\"button\" id=\"emptyResetBtn\" class=\"btn btn-primary\">Reset Filters</button>\n      </div>\n    `;\n    document.getElementById(\"emptyResetBtn\").addEventListener(\"click\", resetAllFilters);\n    return;\n  }\n\n  grid.innerHTML = carsList.map(buildCarCardHtml).join(\"\");\n  attachCardWishlistListeners(grid);\n}\n\nfunction resetAllFilters() {\n  const searchInput = document.getElementById(\"searchInput\");\n  const sortSelect = document.getElementById(\"sortSelect\");\n\n  if (searchInput) searchInput.value = \"\";\n  if (sortSelect) sortSelect.value = \"default\";\n\n  document.querySelectorAll('#filtersSidebar input[type=\"checkbox\"]').forEach((box) => {\n    box.checked = false;\n  });\n\n  applySearchFiltersAndSort();\n}\n","Overwrite":true,"Path":"C:\\Users\\User\\OneDrive\\Desktop\\CarVault project\\js\\explore.js"}},{"name":"edit_file","args":{"Path":"C:\\Users\\User\\OneDrive\\Desktop\\CarVault project\\pages\\car-details.html","Replacement":"      <!-- Breadcrumb Navigation -->\n      <nav class=\"breadcrumb\" aria-label=\"Breadcrumb\">\n        <a href=\"../index.html\">Home</a>\n        <span aria-hidden=\"true\">/</span>\n        <a href=\"explore-cars.html\">Explore Cars</a>\n        <span aria-hidden=\"true\">/</span>\n        <span id=\"breadcrumbCarName\">Porsche 911 Carrera GTS</span>\n      </nav>\n\n      <!-- Main Car Details Card -->\n      <section class=\"details-card-shell\">\n        <div class=\"details-split\">\n          <!-- Left: Large Image + 3 Gallery Thumbnails -->\n          <div>\n            <div class=\"gallery-main\">\n              <img id=\"mainCarImage\" src=\"../images/cars/porsche-911.jpg\" alt=\"Selected car view\">\n            </div>\n            <div id=\"galleryThumbs\" class=\"gallery-thumbs\" aria-label=\"Other car views\">\n              <!-- Populated by js/car-details.js -->\n            </div>\n          </div>\n\n          <!-- Right: Specifications, Book & Wishlist Buttons -->\n          <div class=\"details-info\">\n            <h1 id=\"carTitle\">Porsche 911 Carrera GTS</h1>\n            <span id=\"carConditionBadge\" class=\"details-status\">Featured · 2025</span>\n            <div id=\"carPrice\" class=\"details-price\">PKR 69,500,000</div>\n\n            <ul class=\"specs-list\">\n              <li><span>Engine</span><strong id=\"specEngine\">3.6L Flat-Six</strong></li>\n              <li><span>Power</span><strong id=\"specPower\">532 HP</strong></li>\n              <li><span>0–100 km/h</span><strong id=\"specSpeed\">3.0 sec</strong></li>\n              <li><span>Fuel</span><strong id=\"specFuel\">Petrol</strong></li>\n              <li><span>Transmission</span><strong id=\"specTransmission\">PDK Automatic</strong></li>\n              <li><span>Body Style</span><strong id=\"specType\">Coupe</strong></li>\n            </ul>\n\n            <div class=\"details-actions\">\n              <button type=\"button\" id=\"bookTestDriveBtn\" class=\"btn btn-primary\">Book a Test Drive &#8599;</button>\n              <button type=\"button\" id=\"wishlistToggleBtn\" class=\"btn btn-outline\">&#9825; Wishlist</button>\n            </div>\n          </div>\n        </div>\n\n        <!-- Description Below Main Details -->\n        <div class=\"details-description-box\">\n          <h2>Description</h2>\n          <p id=\"carDescription\">\n            An unmistakable icon of precision engineering, pairing a 3.6L flat-six powertrain with razor-sharp chassis balance.\n          </p>\n        </div>","Target":"      <!-- Breadcrumb Navigation -->\n      <nav class=\"breadcrumb\" aria-label=\"Breadcrumb\">\n        <a href=\"../index.html\">Home</a>\n        <span aria-hidden=\"true\">/</span>\n        <a href=\"explore-cars.html\">Explore Cars</a>\n        <span aria-hidden=\"true\">/</span>\n        <span id=\"breadcrumbCarName\">Honda Civic</span>\n      </nav>\n\n      <!-- Main Car Details Card -->\n      <section class=\"details-card-shell\">\n        <div class=\"details-split\">\n          <!-- Left: Large Image + 3 Gallery Thumbnails -->\n          <div>\n            <div class=\"gallery-main\">\n              <img id=\"mainCarImage\" src=\"../images/cars/honda-civic-main.jpg\" alt=\"Selected car view\">\n            </div>\n            <div id=\"galleryThumbs\" class=\"gallery-thumbs\" aria-label=\"Other car views\">\n              <!-- Populated by js/car-details.js -->\n            </div>\n          </div>\n\n          <!-- Right: Specifications, Book & Wishlist Buttons -->\n          <div class=\"details-info\">\n            <h1 id=\"carTitle\">Honda Civic</h1>\n            <span id=\"carConditionBadge\" class=\"details-status\">Brand New · 2026</span>\n            <div id=\"carPrice\" class=\"details-price\">Rs. 1.02 Cr</div>\n\n            <ul class=\"specs-list\">\n              <li><span>Engine</span><strong id=\"specEngine\">1500cc</strong></li>\n              <li><span>Fuel</span><strong id=\"specFuel\">Petrol</strong></li>\n              <li><span>Transmission</span><strong id=\"specTransmission\">Automatic</strong></li>\n              <li><span>Type</span><strong id=\"specType\">Sedan</strong></li>\n            </ul>\n\n            <div class=\"details-actions\">\n              <button type=\"button\" id=\"bookTestDriveBtn\" class=\"btn btn-primary\">BOOK</button>\n              <button type=\"button\" id=\"wishlistToggleBtn\" class=\"btn btn-outline\">&#9825; Wishlist</button>\n            </div>\n          </div>\n        </div>\n\n        <!-- Description Below Main Details -->\n        <div class=\"details-description-box\">\n          <h2>Description</h2>\n          <p id=\"carDescription\">\n            Comfortable, stylish and modern sedan with advanced features. Enjoy it if you want a good city drive.\n          </p>\n        </div>"}},{"name":"write_file","args":{"Content":"/* ==========================================================================\n   CAR VAULT — Car Details Page Logic (js/car-details.js)\n   Loads the selected car from URL ?id=..., manages gallery thumbnails,\n   wishlist toggle, monthly installment estimator, and the booking button.\n   ========================================================================== */\n\nlet activeCar = null;\n\ndocument.addEventListener(\"DOMContentLoaded\", () => {\n  const params = new URLSearchParams(window.location.search);\n  const carId = params.get(\"id\") || \"porsche-911-carrera-gts\";\n  activeCar = getCarById(carId);\n\n  renderCarDetails(activeCar);\n  setupInstallmentEstimator();\n\n  document.getElementById(\"bookTestDriveBtn\").addEventListener(\"click\", () => {\n    openBookingModal(activeCar.id);\n  });\n\n  document.getElementById(\"wishlistToggleBtn\").addEventListener(\"click\", () => {\n    toggleWishlistItem(activeCar.id);\n    updateWishlistButtonState();\n  });\n\n  document.addEventListener(\"carvault:wishlist-updated\", (event) => {\n    if (!event.detail || event.detail.carId === activeCar.id) {\n      updateWishlistButtonState();\n    }\n  });\n});\n\nfunction renderCarDetails(car) {\n  document.title = `${car.model} | CAR VAULT`;\n  document.getElementById(\"breadcrumbCarName\").textContent = car.model;\n  document.getElementById(\"carTitle\").textContent = car.model;\n  document.getElementById(\"carConditionBadge\").textContent = `${car.tag || car.condition} \\u00B7 ${car.year}`;\n  document.getElementById(\"carPrice\").textContent = car.priceLabel;\n  document.getElementById(\"specEngine\").textContent = car.engine;\n  document.getElementById(\"specPower\").textContent = car.power || \"—\";\n  document.getElementById(\"specSpeed\").textContent = car.speed || \"—\";\n  document.getElementById(\"specFuel\").textContent = car.fuel;\n  document.getElementById(\"specTransmission\").textContent = car.transmission;\n  document.getElementById(\"specType\").textContent = car.type;\n  document.getElementById(\"carDescription\").textContent = car.description;\n\n  const mainImage = document.getElementById(\"mainCarImage\");\n  mainImage.src = `../${car.image}`;\n  mainImage.alt = `${car.year} ${car.model} main view`;\n\n  const thumbsWrap = document.getElementById(\"galleryThumbs\");\n  const views = car.gallery && car.gallery.length ? car.gallery : [car.image];\n\n  thumbsWrap.innerHTML = views\n    .map(\n      (imgPath, index) => `\n      <button\n        type=\"button\"\n        class=\"thumb-btn ${index === 0 ? \"active\" : \"\"}\"\n        data-img=\"../${imgPath}\"\n        aria-label=\"View angle ${index + 1} of ${car.model}\"\n      >\n        <img src=\"../${imgPath}\" alt=\"${car.model} view ${index + 1}\">\n      </button>\n    `\n    )\n    .join(\"\");\n\n  thumbsWrap.querySelectorAll(\".thumb-btn\").forEach((thumb) => {\n    thumb.addEventListener(\"click\", () => {\n      mainImage.src = thumb.dataset.img;\n      thumbsWrap.querySelectorAll(\".thumb-btn\").forEach((b) => b.classList.remove(\"active\"));\n      thumb.classList.add(\"active\");\n    });\n  });\n\n  updateWishlistButtonState();\n}\n\nfunction updateWishlistButtonState() {\n  const btn = document.getElementById(\"wishlistToggleBtn\");\n  if (!btn || !activeCar) return;\n\n  const saved = isInWishlist(activeCar.id);\n  btn.classList.toggle(\"is-active\", saved);\n  btn.innerHTML = saved ? \"&#9829; Saved in Wishlist\" : \"&#9825; Wishlist\";\n}\n\nfunction setupInstallmentEstimator() {\n  const downSelect = document.getElementById(\"downPaymentSelect\");\n  const tenureSelect = document.getElementById(\"tenureSelect\");\n  const resultEl = document.getElementById(\"estimatedMonthly\");\n\n  function calculateMonthly() {\n    const downRatio = Number(downSelect.value);\n    const months = Number(tenureSelect.value) * 12;\n    const financedAmount = activeCar.price * (1 - downRatio);\n    const monthly = financedAmount / months;\n\n    resultEl.textContent = formatShortPkr(monthly) + \" / mo\";\n  }\n\n  downSelect.addEventListener(\"change\", calculateMonthly);\n  tenureSelect.addEventListener(\"change\", calculateMonthly);\n  calculateMonthly();\n}\n\nfunction formatShortPkr(amount) {\n  return `PKR ${Math.round(amount).toLocaleString(\"en-PK\")}`;\n}\n","Overwrite":true,"Path":"C:\\Users\\User\\OneDrive\\Desktop\\CarVault project\\js\\car-details.js"}},{"name":"edit_file","args":{"Path":"C:\\Users\\User\\OneDrive\\Desktop\\CarVault project\\css\\common.css","Replacement":".car-card-title {\n  font-size: 1.2rem;\n  font-weight: 800;\n  color: var(--pure-white);\n  margin-bottom: 4px;\n  letter-spacing: -0.01em;\n}\n\n.car-card-specs {\n  font-size: 0.82rem;\n  color: var(--text-muted);\n  margin-bottom: 8px;\n}","Target":".car-card-title {\n  font-size: 1.2rem;\n  font-weight: 800;\n  color: var(--pure-white);\n  margin-bottom: 6px;\n  letter-spacing: -0.01em;\n}"}},{"name":"edit_file","args":{"Path":"C:\\Users\\User\\OneDrive\\Desktop\\CarVault project\\css\\pages.css","Replacement":".brand-pill-card {\n  background-color: var(--bg-surface);\n  border: 1px solid var(--border-grey);\n  border-radius: var(--radius-sm);\n  padding: 20px 12px;\n  text-align: center;\n  font-weight: 700;\n  font-size: 0.96rem;\n  letter-spacing: 0.02em;\n  color: var(--pure-white);\n  display: flex;\n  flex-direction: column;\n  align-items: center;\n  gap: 6px;\n  transition: all 0.2s ease;\n}\n\n.brand-pill-card small {\n  font-size: 0.66rem;\n  font-weight: 700;\n  letter-spacing: 0.14em;\n  color: var(--text-muted);\n  transition: color 0.2s ease;\n}\n\n.brand-pill-card:hover {\n  border-color: var(--gold);\n  background-color: var(--bg-surface-2);\n  color: var(--gold);\n  transform: translateY(-2px);\n}\n\n.brand-pill-card:hover small {\n  color: var(--gold);\n}","Target":".brand-pill-card {\n  background-color: var(--bg-surface);\n  border: 1px solid var(--border-grey);\n  border-radius: var(--radius-sm);\n  padding: 18px 12px;\n  text-align: center;\n  font-weight: 700;\n  font-size: 0.92rem;\n  letter-spacing: 0.03em;\n  color: var(--pure-white);\n  transition: all 0.2s ease;\n}\n\n.brand-pill-card:hover {\n  border-color: var(--gold);\n  background-color: var(--bg-surface-2);\n  color: var(--gold);\n  transform: translateY(-2px);\n}"}}]}
