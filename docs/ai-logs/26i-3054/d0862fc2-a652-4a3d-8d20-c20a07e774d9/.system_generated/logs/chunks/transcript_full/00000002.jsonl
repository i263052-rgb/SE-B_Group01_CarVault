       <button type=\"button\" id=\"bookTestDriveBtn\" class=\"btn btn-primary\">BOOK</button>\n              <button type=\"button\" id=\"wishlistToggleBtn\" class=\"btn btn-outline\">&#9825; Wishlist</button>\n            </div>\n          </div>\n        </div>\n\n        <!-- Description Below Main Details -->\n        <div class=\"details-description-box\">\n          <h2>Description</h2>\n          <p id=\"carDescription\">\n            Comfortable, stylish and modern sedan with advanced features. Enjoy it if you want a good city drive.\n          </p>\n        </div>\n\n        <!-- Quick Monthly Installment Estimator (Logic & Calculation) -->\n        <div class=\"estimator-box\">\n          <h3>Quick Monthly Installment Estimator (Demo)</h3>\n          <div class=\"estimator-controls\">\n            <div class=\"form-group\" style=\"margin-bottom: 0;\">\n              <label for=\"downPaymentSelect\">Down Payment</label>\n              <select id=\"downPaymentSelect\">\n                <option value=\"0.20\">20% Down Payment</option>\n                <option value=\"0.30\" selected>30% Down Payment</option>\n                <option value=\"0.40\">40% Down Payment</option>\n                <option value=\"0.50\">50% Down Payment</option>\n              </select>\n            </div>\n\n            <div class=\"form-group\" style=\"margin-bottom: 0;\">\n              <label for=\"tenureSelect\">Installment Period</label>\n              <select id=\"tenureSelect\">\n                <option value=\"3\">3 Years (36 months)</option>\n                <option value=\"5\" selected>5 Years (60 months)</option>\n                <option value=\"7\">7 Years (84 months)</option>\n              </select>\n            </div>\n\n            <div class=\"estimator-result\">\n              <span>Estimated Monthly (0% Demo Markup)</span>\n              <strong id=\"estimatedMonthly\">Rs. 1.19 Lac / mo</strong>\n            </div>\n          </div>\n        </div>\n      </section>\n    </div>\n  </main>\n\n  <div id=\"siteFooter\"></div>\n\n  <script src=\"../js/cars-data.js\"></script>\n  <script src=\"../js/common.js\"></script>\n  <script src=\"../js/car-details.js\"></script>\n</body>\n</html>\n","Overwrite":true,"Path":"C:\\Users\\User\\OneDrive\\Desktop\\CarVault project\\pages\\car-details.html"}},{"name":"write_file","args":{"Content":"/* ==========================================================================\n   CAR VAULT — Shared UI, Navigation, Wishlist & 4-State Booking Flow (js/common.js)\n   ========================================================================== */\n\nconst PATH_PREFIX = document.body.dataset.prefix || \"\";\nconst CURRENT_PAGE = document.body.dataset.page || \"home\";\nconst WISHLIST_STORAGE_KEY = \"carvault_wishlist\";\nconst BOOKINGS_STORAGE_KEY = \"carvault_bookings\";\n\n/* ---------- Helper Functions ---------- */\nfunction getCarById(carId) {\n  return CAR_VAULT_CARS.find((car) => car.id === carId) || CAR_VAULT_CARS.find((car) => car.id === \"honda-civic\") || CAR_VAULT_CARS[0];\n}\n\nfunction getWishlist() {\n  try {\n    const saved = JSON.parse(localStorage.getItem(WISHLIST_STORAGE_KEY));\n    return Array.isArray(saved) ? saved : [];\n  } catch (error) {\n    return [];\n  }\n}\n\nfunction saveWishlist(list) {\n  localStorage.setItem(WISHLIST_STORAGE_KEY, JSON.stringify(list));\n}\n\nfunction isInWishlist(carId) {\n  return getWishlist().includes(carId);\n}\n\nfunction toggleWishlistItem(carId) {\n  const list = getWishlist();\n  const exists = list.includes(carId);\n  const updated = exists ? list.filter((id) => id !== carId) : [...list, carId];\n  saveWishlist(updated);\n  updateSavedBadges();\n  showToast(exists ? \"Removed from Wishlist\" : \"Saved to Wishlist\");\n  return !exists;\n}\n\nfunction getBookings() {\n  try {\n    const saved = JSON.parse(localStorage.getItem(BOOKINGS_STORAGE_KEY));\n    return Array.isArray(saved) ? saved : [];\n  } catch (error) {\n    return [];\n  }\n}\n\nfunction showToast(message) {\n  const existing = document.querySelector(\".toast\");\n  if (existing) {\n    existing.remove();\n  }\n  const toast = document.createElement(\"div\");\n  toast.className = \"toast\";\n  toast.textContent = message;\n  document.body.appendChild(toast);\n  setTimeout(() => {\n    toast.remove();\n  }, 2600);\n}\n\n/* ---------- Shared Car Card Renderer ---------- */\nfunction buildCarCardHtml(car) {\n  const detailsUrl = `${PATH_PREFIX}pages/car-details.html?id=${encodeURIComponent(car.id)}`;\n  const saved = isInWishlist(car.id);\n\n  return `\n    <article class=\"car-card\">\n      <a href=\"${detailsUrl}\" class=\"car-card-link\">\n        <div class=\"car-card-image-wrap\">\n          <img src=\"${PATH_PREFIX}${car.image}\" alt=\"${car.year} ${car.model}\" loading=\"lazy\">\n          <span class=\"car-badge\">${car.condition}</span>\n        </div>\n        <div class=\"car-card-body\">\n          <div class=\"car-card-meta\">${car.brand} &middot; ${car.type}</div>\n          <h3 class=\"car-card-title\">${car.model}</h3>\n          <div class=\"car-card-price\">${car.priceLabel}</div>\n        </div>\n      </a>\n      <div class=\"car-card-footer\">\n        <a href=\"${detailsUrl}\" class=\"card-details-cta\">View Details &rarr;</a>\n        <button\n          type=\"button\"\n          class=\"icon-wish-btn ${saved ? \"saved\" : \"\"}\"\n          data-wish-id=\"${car.id}\"\n          aria-label=\"Toggle wishlist for ${car.model}\"\n        >\n          ${saved ? \"&#9829; Saved\" : \"&#9825; Save\"}\n        </button>\n      </div>\n    </article>\n  `;\n}\n\nfunction attachCardWishlistListeners(container) {\n  if (!container) return;\n  container.querySelectorAll(\"[data-wish-id]\").forEach((btn) => {\n    btn.addEventListener(\"click\", () => {\n      const carId = btn.dataset.wishId;\n      const nowSaved = toggleWishlistItem(carId);\n      btn.classList.toggle(\"saved\", nowSaved);\n      btn.innerHTML = nowSaved ? \"&#9829; Saved\" : \"&#9825; Save\";\n\n      // Notify page-specific listeners if needed (e.g. Car Details button)\n      document.dispatchEvent(new CustomEvent(\"carvault:wishlist-updated\", { detail: { carId } }));\n    });\n  });\n}\n\n/* ---------- Shared Header & Footer ---------- */\nfunction renderHeader() {\n  const headerMount = document.getElementById(\"siteHeader\");\n  if (!headerMount) return;\n\n  const homeUrl = `${PATH_PREFIX}index.html`;\n  const exploreUrl = `${PATH_PREFIX}pages/explore-cars.html`;\n\n  headerMount.innerHTML = `\n    <header class=\"site-header\">\n      <div class=\"container navbar\">\n        <a href=\"${homeUrl}\" class=\"brand-logo\">\n          <img src=\"${PATH_PREFIX}images/logo/car-vault-logo.jpg\" alt=\"CAR VAULT Logo\">\n          <span>CAR <strong>VAULT</strong></span>\n        </a>\n\n        <div class=\"mobile-controls\">\n          <button type=\"button\" id=\"mobileSavedBtn\" class=\"icon-wish-btn\" aria-label=\"Open Saved Cars\">\n            &#9825; <span class=\"saved-badge js-saved-count\">0</span>\n          </button>\n          <button\n            type=\"button\"\n            id=\"menuToggleBtn\"\n            class=\"menu-toggle\"\n            aria-label=\"Toggle navigation menu\"\n            aria-expanded=\"false\"\n            aria-controls=\"mainNavLinks\"\n          >\n            &#9776;\n          </button>\n        </div>\n\n        <ul id=\"mainNavLinks\" class=\"nav-links\">\n          <li><a href=\"${homeUrl}\" class=\"${CURRENT_PAGE === \"home\" ? \"active\" : \"\"}\">Home</a></li>\n          <li><a href=\"${exploreUrl}\" class=\"${CURRENT_PAGE === \"explore\" ? \"active\" : \"\"}\">Explore</a></li>\n          <li><a href=\"${PATH_PREFIX}pages/brands.html\" title=\"Teammate page (coming when merged)\">Brands</a></li>\n          <li><a href=\"${PATH_PREFIX}pages/new-arrivals.html\" title=\"Teammate page (coming when merged)\">New</a></li>\n          <li><a href=\"${PATH_PREFIX}pages/offers.html\" title=\"Teammate page (coming when merged)\">Offers</a></li>\n          <li><a href=\"${PATH_PREFIX}pages/about.html\" title=\"Teammate page (coming when merged)\">About</a></li>\n          <li><a href=\"${PATH_PREFIX}pages/contact.html\" title=\"Teammate page (coming when merged)\">Contact</a></li>\n          <li><a href=\"${PATH_PREFIX}pages/compare-cars.html\" title=\"Teammate page (coming when merged)\">Compare</a></li>\n          <li>\n            <button type=\"button\" id=\"navTestDriveBtn\" class=\"nav-action-link\">Test Drive</button>\n          </li>\n          <li>\n            <button type=\"button\" id=\"navSavedCarsBtn\" class=\"nav-action-link\">\n              Saved Cars &#9825; <span class=\"saved-badge js-saved-count\">0</span>\n            </button>\n          </li>\n        </ul>\n      </div>\n    </header>\n  `;\n\n  // Mobile hamburger toggle\n  const menuToggleBtn = document.getElementById(\"menuToggleBtn\");\n  const mainNavLinks = document.getElementById(\"mainNavLinks\");\n  menuToggleBtn.addEventListener(\"click\", () => {\n    const isOpen = mainNavLinks.classList.toggle(\"open\");\n    menuToggleBtn.setAttribute(\"aria-expanded\", String(isOpen));\n  });\n\n  // Saved Cars modal triggers\n  document.getElementById(\"navSavedCarsBtn\").addEventListener(\"click\", openWishlistModal);\n  document.getElementById(\"mobileSavedBtn\").addEventListener(\"click\", openWishlistModal);\n\n  // Test Drive modal trigger (defaults to current car if on Car Details, else Honda Civic)\n  document.getElementById(\"navTestDriveBtn\").addEventListener(\"click\", () => {\n    const urlCarId = new URLSearchParams(window.location.search).get(\"id\");\n    openBookingModal(urlCarId || \"honda-civic\");\n  });\n\n  updateSavedBadges();\n}\n\nfunction renderFooter() {\n  const footerMount = document.getElementById(\"siteFooter\");\n  if (!footerMount) return;\n\n  footerMount.innerHTML = `\n    <footer class=\"site-footer\">\n      <div class=\"container\">\n        <div class=\"footer-grid\">\n          <div class=\"footer-col\">\n            <h3>CAR VAULT</h3>\n            <p>\n              Your trusted destination for brand-new sedans, SUVs, hatchbacks, and pickup trucks.\n              Browse transparent pricing, compare specifications, and request a test drive online.\n            </p>\n          </div>\n\n          <div class=\"footer-col\">\n            <h4>Pages</h4>\n            <ul>\n              <li><a href=\"${PATH_PREFIX}index.html\">Home</a></li>\n              <li><a href=\"${PATH_PREFIX}pages/explore-cars.html\">Explore Cars</a></li>\n              <li><a href=\"${PATH_PREFIX}pages/car-details.html?id=honda-civic\">Car Details</a></li>\n            </ul>\n          </div>\n\n          <div class=\"footer-col\">\n            <h4>Popular Brands</h4>\n            <ul>\n              <li><a href=\"${PATH_PREFIX}pages/explore-cars.html?brand=Toyota\">Toyota</a></li>\n              <li><a href=\"${PATH_PREFIX}pages/explore-cars.html?brand=Honda\">Honda</a></li>\n              <li><a href=\"${PATH_PREFIX}pages/explore-cars.html?brand=Kia\">Kia</a></li>\n              <li><a href=\"${PATH_PREFIX}pages/explore-cars.html?brand=Audi\">Audi</a></li>\n            </ul>\n          </div>\n\n          <div class=\"footer-col\">\n            <h4>Showroom Demo</h4>\n            <p>Islamabad, Pakistan</p>\n            <p>Mon - Sat: 10:00 AM - 8:00 PM</p>\n            <p>CL1000 Semester Project (Group 01)</p>\n          </div>\n        </div>\n\n        <div class=\"footer-bottom\">\n          <span>&copy; 2026 CAR VAULT. Built by Hamza Taqvim (26I-3054) &amp; Team.</span>\n          <span class=\"ai-disclosure\">Images on this website were generated using Antigravity Image Generator.</span>\n        </div>\n      </div>\n    </footer>\n  `;\n}\n\nfunction updateSavedBadges() {\n  const count = getWishlist().length;\n  document.querySelectorAll(\".js-saved-count\").forEach((badge) => {\n    badge.textContent = count;\n  });\n}\n\n/* ---------- Wishlist Modal (Saved Cars Viewer) ---------- */\nfunction ensureSharedModals() {\n  if (document.getElementById(\"wishlistModal\")) return;\n\n  const modalWrapper = document.createElement(\"div\");\n  modalWrapper.innerHTML = `\n    <!-- Saved Cars / Wishlist Modal -->\n    <div id=\"wishlistModal\" class=\"modal-backdrop hidden\" role=\"dialog\" aria-modal=\"true\" aria-labelledby=\"wishlistModalTitle\">\n      <div class=\"modal-box\">\n        <div class=\"modal-header\">\n          <h2 id=\"wishlistModalTitle\">Saved Cars (Wishlist)</h2>\n          <button type=\"button\" id=\"closeWishlistModal\" class=\"modal-close\" aria-label=\"Close Saved Cars\">&times;</button>\n        </div>\n        <div id=\"wishlistModalBody\"></div>\n      </div>\n    </div>\n\n    <!-- 4-State Test Drive Booking Modal -->\n    <div id=\"bookingModal\" class=\"modal-backdrop hidden\" role=\"dialog\" aria-modal=\"true\" aria-labelledby=\"bookingModalTitle\">\n      <div class=\"modal-box\">\n        <div class=\"modal-header\">\n          <h2 id=\"bookingModalTitle\">Test Drive Booking Request</h2>\n          <button type=\"button\" id=\"closeBookingModal\" class=\"modal-close\" aria-label=\"Close Booking Modal\">&times;</button>\n        </div>\n        <div id=\"bookingModalBody\"></div>\n      </div>\n    </div>\n  `;\n  document.body.appendChild(modalWrapper);\n\n  document.getElementById(\"closeWishlistModal\").addEventListener(\"click\", () => {\n    document.getElementById(\"wishlistModal\").classList.add(\"hidden\");\n  });\n\n  document.getElementById(\"closeBookingModal\").addEventListener(\"click\", () => {\n    document.getElementById(\"bookingModal\").classList.add(\"hidden\");\n  });\n\n  // Close modals when clicking dark backdrop\n  document.getElementById(\"wishlistModal\").addEventListener(\"click\", (event) => {\n    if (event.target.id === \"wishlistModal\") {\n      event.target.classList.add(\"hidden\");\n    }\n  });\n\n  document.getElementById(\"bookingModal\").addEventListener(\"click\", (event) => {\n    if (event.target.id === \"bookingModal\") {\n      event.target.classList.add(\"hidden\");\n    }\n  });\n}\n\nfunction openWishlistModal() {\n  ensureSharedModals();\n  renderWishlistModalBody();\n  document.getElementById(\"wishlistModal\").classList.remove(\"hidden\");\n}\n\nfunction renderWishlistModalBody() {\n  const body = document.getElementById(\"wishlistModalBody\");\n  const savedIds = getWishlist();\n  const savedCars = CAR_VAULT_CARS.filter((car) => savedIds.includes(car.id));\n\n  if (savedCars.length === 0) {\n    body.innerHTML = `\n      <div class=\"empty-state\">\n        <h3>No saved cars yet</h3>\n        <p>Click the Wishlist button on any car to save it here for quick comparison.</p>\n        <a href=\"${PATH_PREFIX}pages/explore-cars.html\" class=\"btn btn-primary\">Explore Cars</a>\n      </div>\n    `;\n    return;\n  }\n\n  body.innerHTML = `\n    <div class=\"wishlist-list\">\n      ${savedCars\n        .map(\n          (car) => `\n          <div class=\"wishlist-item\">\n            <div class=\"wishlist-item-info\">\n              <img src=\"${PATH_PREFIX}${car.image}\" alt=\"${car.model}\">\n              <div>\n                <strong>${car.model}</strong>\n                <div style=\"font-size: 0.88rem; color: #4b5563;\">${car.priceLabel}</div>\n              </div>\n            </div>\n            <div class=\"wishlist-actions\">\n              <a href=\"${PATH_PREFIX}pages/car-details.html?id=${encodeURIComponent(car.id)}\" class=\"btn btn-navy\" style=\"padding: 7px 12px; font-size: 0.8rem;\">View</a>\n              <button type=\"button\" class=\"btn btn-outline js-remove-wish\" data-id=\"${car.id}\" style=\"padding: 7px 12px; font-size: 0.8rem;\">Remove</button>\n            </div>\n          </div>\n        `\n        )\n        .join(\"\")}\n    </div>\n  `;\n\n  body.querySelectorAll(\".js-remove-wish\").forEach((btn) => {\n    btn.addEventListener(\"click\", () => {\n      toggleWishlistItem(btn.dataset.id);\n      renderWishlistModalBody();\n      document.dispatchEvent(new CustomEvent(\"carvault:wishlist-updated\", { detail: { carId: btn.dataset.id } }));\n    });\n  });\n}\n\n/* ==========================================================================\n   4-STATE TEST DRIVE BOOKING FLOW (Vertical Prototype Implementation)\n   State 1: Empty Form | State 2: Filled Form | State 3: Success | State 4: Failed Validation\n   ========================================================================== */\nlet currentBookingDraft = {\n  carId: \"honda-civic\",\n  name: \"\",\n  phone: \"\",\n  email: \"\",\n  date: \"\",\n  time: \"\"\n};\n\nfunction openBookingModal(carId) {\n  ensureSharedModals();\n  const selectedCar = getCarById(carId);\n  // Reset to State 1 (Empty Form) whenever opened fresh\n  currentBookingDraft = {\n    carId: selectedCar.id,\n    name: \"\",\n    phone: \"\",\n    email: \"\",\n    date: \"\",\n    time: \"\"\n  };\n  renderBookingFormState();\n  document.getElementById(\"bookingModal\").classList.remove(\"hidden\");\n}\n\nfunction renderBookingFormState() {\n  const body = document.getElementById(\"bookingModalBody\");\n  const todayStr = new Date().toISOString().split(\"T\")[0];\n\n  body.innerHTML = `\n    <p class=\"demo-note\">\n      Demo Request: Submit your preferred date and time to request a showroom test drive. No real dealership appointment is sent.\n    </p>\n\n    <form id=\"testDriveBookingForm\" novalidate>\n      <div class=\"form-group\">\n        <label for=\"bookingCarSelect\">Selected Car</label>\n        <select id=\"bookingCarSelect\" name=\"carId\">\n          ${CAR_VAULT_CARS.map(\n            (c) => `<option value=\"${c.id}\" ${c.id === currentBookingDraft.carId ? \"selected\" : \"\"}>${c.model} (${c.priceLabel})</option>`\n          ).join(\"\")}\n        </select>\n      </div>\n\n      <div class=\"form-group\">\n        <label for=\"bookingName\">Name</label>\n        <input type=\"text\" id=\"bookingName\" name=\"name\" placeholder=\"Enter your full name\" value=\"${escapeHtmlAttr(currentBookingDraft.name)}\" required>\n      </div>\n\n      <div class=\"form-row-2\">\n        <div class=\"form-group\">\n          <label for=\"bookingPhone\">Phone number</label>\n          <input type=\"tel\" id=\"bookingPhone\" name=\"phone\" placeholder=\"e.g. 03001234567\" value=\"${escapeHtmlAttr(currentBookingDraft.phone)}\" required>\n        </div>\n\n        <div class=\"form-group\">\n          <label for=\"bookingEmail\">Email</label>\n          <input type=\"email\" id=\"bookingEmail\" name=\"email\" placeholder=\"e.g. hamza@example.com\" value=\"${escapeHtmlAttr(currentBookingDraft.email)}\" required>\n        </div>\n      </div>\n\n      <div class=\"form-row-2\">\n        <div class=\"form-group\">\n          <label for=\"bookingDate\">Date</label>\n          <input type=\"date\" id=\"bookingDate\" name=\"date\" min=\"${todayStr}\" value=\"${escapeHtmlAttr(currentBookingDraft.date)}\" required>\n        </div>\n\n        <div class=\"form-group\">\n          <label for=\"bookingTime\">Time</label>\n          <select id=\"bookingTime\" name=\"time\" required>\n            <option value=\"\">Select time</option>\n            ${[\"10:00 AM\", \"11:30 AM\", \"01:00 PM\", \"03:00 PM\", \"05:00 PM\"]\n              .map((t) => `<option value=\"${t}\" ${currentBookingDraft.time === t ? \"selected\" : \"\"}>${t}</option>`)\n              .join(\"\")}\n          </select>\n        </div>\n      </div>\n\n      <button type=\"submit\" class=\"btn btn-primary\" style=\"width: 100%; margin-top: 6px;\">Submit</button>\n    </form>\n  `;\n\n  document.getElementById(\"testDriveBookingForm\").addEventListener(\"submit\", handleBookingSubmit);\n}\n\nfunction validatePhoneAndEmail(phone, email) {\n  const digitsOnly = phone.replace(/[\\s\\-()+]/g, \"\");\n  const isPhoneValid = /^\\d{10,13}$/.test(digitsOnly);\n  const isEmailValid = /^[^\\s@]+@[^\\s@]+\\.[^\\s@]{2,}$/.test(email.trim());\n  return isPhoneValid && isEmailValid;\n}\n\nfunction handleBookingSubmit(event) {\n  event.preventDefault();\n  const form = event.target;\n\n  // Save State 2 (Filled Form) values so \"Try Again\" keeps what the user typed\n  currentBookingDraft = {\n    carId: form.carId.value,\n    name: form.name.value.trim(),\n    phone: form.phone.value.trim(),\n    email: form.email.value.trim(),\n    date: form.date.value,\n    time: form.time.value\n  };\n\n  const hasRequiredBasics =\n    currentBookingDraft.name.length >= 2 &&\n    Boolean(currentBookingDraft.date) &&\n    Boolean(currentBookingDraft.time);\n\n  // State 4: Failed Validation (matching paper prototype State 4)\n  if (!hasRequiredBasics || !validatePhoneAndEmail(currentBookingDraft.phone, currentBookingDraft.email)) {\n    renderBookingFailedState();\n    return;\n  }\n\n  // State 3: Success\n  const selectedCar = getCarById(currentBookingDraft.carId);\n  const savedBookings = getBookings();\n  savedBookings.push({\n    ...currentBookingDraft,\n    carModel: selectedCar.model,\n    createdAt: new Date().toISOString()\n  });\n  localStorage.setItem(BOOKINGS_STORAGE_KEY, JSON.stringify(savedBookings));\n\n  renderBookingSuccessState(selectedCar, currentBookingDraft);\n}\n\nfunction renderBookingSuccessState(selectedCar, booking) {\n  const body = document.getElementById(\"bookingModalBody\");\n  body.innerHTML = `\n    <div class=\"state-box success\">\n      <h3>Booking Confirmed!</h3>\n      <p>Your test drive booking request has been submitted.</p>\n\n      <div class=\"state-details\">\n        <div><strong>Selected Car:</strong> ${selectedCar.model}</div>\n        <div><strong>Applicant:</strong> ${escapeHtmlText(booking.name)}</div>\n        <div><strong>Date:</strong> ${escapeHtmlText(booking.date)}</div>\n        <div><strong>Time:</strong> ${escapeHtmlText(booking.time)}</div>\n      </div>\n\n      <p style=\"font-size: 0.82rem; margin-bottom: 14px;\">\n        Note: This is a frontend demo booking request saved locally in your browser.\n      </p>\n\n      <button type=\"button\" id=\"backToCarBtn\" class=\"btn btn-navy\" style=\"width: 100%;\">\n        Back to Car\n      </button>\n    </div>\n  `;\n\n  document.getElementById(\"backToCarBtn\").addEventListener(\"click\", () => {\n    document.getElementById(\"bookingModal\").classList.add(\"hidden\");\n  });\n}\n\nfunction renderBookingFailedState() {\n  const body = document.getElementById(\"bookingModalBody\");\n  body.innerHTML = `\n    <div class=\"state-box failed\">\n      <h3>Validation Failed</h3>\n      <p style=\"font-weight: 600; margin-bottom: 18px;\">\n        Incorrect phone number or email. Please enter again.\n      </p>\n      <button type=\"button\" id=\"tryAgainBookingBtn\" class=\"btn btn-primary\" style=\"min-width: 160px;\">\n        Try Again\n      </button>\n    </div>\n  `;\n\n  document.getElementById(\"tryAgainBookingBtn\").addEventListener(\"click\", renderBookingFormState);\n}\n\nfunction escapeHtmlText(str) {\n  return String(str).replace(/[&<>\"']/g, (ch) => ({\n    \"&\": \"&amp;\",\n    \"<\": \"&lt;\",\n    \">\": \"&gt;\",\n    '\"': \"&quot;\",\n    \"'\": \"&#39;\"\n  })[ch]);\n}\n\nfunction escapeHtmlAttr(str) {\n  return escapeHtmlText(str);\n}\n\n/* Initialize shared header & footer once DOM is ready */\ndocument.addEventListener(\"DOMContentLoaded\", () => {\n  renderHeader();\n  renderFooter();\n});\n","Overwrite":true,"Path":"C:\\Users\\User\\OneDrive\\Desktop\\CarVault project\\js\\common.js"}},{"name":"write_file","args":{"Content":"/* ==========================================================================\n   CAR VAULT — Home Page Logic (js/home.js)\n   Renders the 2 featured cars (BMW M5 & Mercedes C400) and popular brand shortcuts.\n   ========================================================================== */\n\ndocument.addEventListener(\"DOMContentLoaded\", () => {\n  renderFeaturedCars();\n  renderPopularBrands();\n\n  // Keep card wishlist buttons synced if changed inside the Saved Cars modal\n  document.addEventListener(\"carvault:wishlist-updated\", () => {\n    renderFeaturedCars();\n  });\n});\n\nfunction renderFeaturedCars() {\n  const grid = document.getElementById(\"featuredCarsGrid\");\n  if (!grid) return;\n\n  const featuredCars = CAR_VAULT_CARS.filter((car) => car.featured);\n  grid.innerHTML = featuredCars.map(buildCarCardHtml).join(\"\");\n  attachCardWishlistListeners(grid);\n}\n\nfunction renderPopularBrands() {\n  const strip = document.getElementById(\"popularBrandsStrip\");\n  if (!strip) return;\n\n  const brands = [\"Toyota\", \"Honda\", \"Kia\", \"Audi\", \"BMW\", \"Mercedes-Benz\"];\n  strip.innerHTML = brands\n    .map(\n      (brand) => `\n      <a href=\"pages/explore-cars.html?brand=${encodeURIComponent(brand)}\" class=\"brand-pill-card\">\n        ${brand}\n      </a>\n    `\n    )\n    .join(\"\");\n}\n","Overwrite":true,"Path":"C:\\Users\\User\\OneDrive\\Desktop\\CarVault project\\js\\home.js"}},{"name":"write_file","args":{"Content":"/* ==========================================================================\n   CAR VAULT — Explore Cars Page Logic (js/explore.js)\n   Implements live search, brand/price/type filtering, sorting, and URL brand pre-filter.\n   ========================================================================== */\n\ndocument.addEventListener(\"DOMContentLoaded\", () => {\n  const searchInput = document.getElementById(\"searchInput\");\n  const sortSelect = document.getElementById(\"sortSelect\");\n  const applyFiltersBtn = document.getElementById(\"applyFiltersBtn\");\n  const resetFiltersBtn = document.getElementById(\"resetFiltersBtn\");\n  const mobileFilterToggle = document.getElementById(\"mobileFilterToggle\");\n  const filtersSidebar = document.getElementById(\"filtersSidebar\");\n\n  // Pre-select brand or search term if passed via URL (e.g., explore-cars.html?brand=Honda)\n  const params = new URLSearchParams(window.location.search);\n  const initialBrand = params.get(\"brand\");\n  const initialSearch = params.get(\"search\");\n\n  if (initialBrand) {\n    const brandCheckbox = document.querySelector(`input[name=\"brand\"][value=\"${CSS.escape(initialBrand)}\"]`);\n    if (brandCheckbox) {\n      brandCheckbox.checked = true;\n    }\n  }\n\n  if (initialSearch && searchInput) {\n    searchInput.value = initialSearch;\n  }\n\n  // Mobile collapsible filter drawer\n  if (mobileFilterToggle && filtersSidebar) {\n    mobileFilterToggle.addEventListener(\"click\", () => {\n      const isOpen = filtersSidebar.classList.toggle(\"open\");\n      mobileFilterToggle.setAttribute(\"aria-expanded\", String(isOpen));\n      mobileFilterToggle.textContent = isOpen ? \"Hide Filters\" : \"Filter Cars\";\n    });\n  }\n\n  // Live search & sort\n  if (searchInput) {\n    searchInput.addEventListener(\"input\", applySearchFiltersAndSort);\n  }\n  if (sortSelect) {\n    sortSelect.addEventListener(\"change\", applySearchFiltersAndSort);\n  }\n\n  // Apply button at bottom of Filter panel (matches paper prototype)\n  if (applyFiltersBtn) {\n    applyFiltersBtn.addEventListener(\"click\", () => {\n      applySearchFiltersAndSort();\n      if (window.innerWidth <= 900 && filtersSidebar) {\n        filtersSidebar.classList.remove(\"open\");\n        mobileFilterToggle.setAttribute(\"aria-expanded\", \"false\");\n        mobileFilterToggle.textContent = \"Filter Cars\";\n      }\n    });\n  }\n\n  // Reset all filters & search\n  if (resetFiltersBtn) {\n    resetFiltersBtn.addEventListener(\"click\", resetAllFilters);\n  }\n\n  // Keep wishlist icons synced if updated from modal\n  document.addEventListener(\"carvault:wishlist-updated\", applySearchFiltersAndSort);\n\n  applySearchFiltersAndSort();\n});\n\nfunction getCheckedValues(name) {\n  return Array.from(document.querySelectorAll(`input[name=\"${name}\"]:checked`)).map((el) => el.value);\n}\n\nfunction matchesPriceRange(price, selectedRanges) {\n  if (selectedRanges.length === 0) return true;\n\n  return selectedRanges.some((range) => {\n    if (range === \"10-50\") return price >= 1000000 && price <= 5000000;\n    if (range === \"50-100\") return price > 5000000 && price <= 10000000;\n    if (range === \"100-plus\") return price > 10000000;\n    return false;\n  });\n}\n\nfunction applySearchFiltersAndSort() {\n  const searchQuery = (document.getElementById(\"searchInput\")?.value || \"\").trim().toLowerCase();\n  const sortOrder = document.getElementById(\"sortSelect\")?.value || \"default\";\n  const selectedBrands = getCheckedValues(\"brand\");\n  const selectedPrices = getCheckedValues(\"price\");\n  const selectedTypes = getCheckedValues(\"type\");\n\n  let filteredCars = CAR_VAULT_CARS.filter((car) => {\n    const matchesSearch =\n      !searchQuery ||\n      car.model.toLowerCase().includes(searchQuery) ||\n      car.brand.toLowerCase().includes(searchQuery) ||\n      car.type.toLowerCase().includes(searchQuery);\n\n    const matchesBrand = selectedBrands.length === 0 || selectedBrands.includes(car.brand);\n    const matchesPrice = matchesPriceRange(car.price, selectedPrices);\n    const matchesType = selectedTypes.length === 0 || selectedTypes.includes(car.type);\n\n    return matchesSearch && matchesBrand && matchesPrice && matchesType;\n  });\n\n  if (sortOrder === \"price-low\") {\n    filteredCars = [...filteredCars].sort((a, b) => a.price - b.price);\n  } else if (sortOrder === \"price-high\") {\n    filteredCars = [...filteredCars].sort((a, b) => b.price - a.price);\n  } else if (sortOrder === \"name-az\") {\n    filteredCars = [...filteredCars].sort((a, b) => a.model.localeCompare(b.model));\n  }\n\n  renderExploreResults(filteredCars);\n}\n\nfunction renderExploreResults(carsList) {\n  const grid = document.getElementById(\"exploreCarsGrid\");\n  const countLabel = document.getElementById(\"resultsCount\");\n  if (!grid || !countLabel) return;\n\n  countLabel.textContent = `Showing ${carsList.length} of ${CAR_VAULT_CARS.length} cars`;\n\n  if (carsList.length === 0) {\n    grid.innerHTML = `\n      <div class=\"empty-state\" style=\"grid-column: 1 / -1;\">\n        <h3>No matching cars found</h3>\n        <p>Try clearing some filters or searching for another car model.</p>\n        <button type=\"button\" id=\"emptyResetBtn\" class=\"btn btn-primary\">Reset Filters</button>\n      </div>\n    `;\n    document.getElementById(\"emptyResetBtn\").addEventListener(\"click\", resetAllFilters);\n    return;\n  }\n\n  grid.innerHTML = carsList.map(buildCarCardHtml).join(\"\");\n  attachCardWishlistListeners(grid);\n}\n\nfunction resetAllFilters() {\n  const searchInput = document.getElementById(\"searchInput\");\n  const sortSelect = document.getElementById(\"sortSelect\");\n\n  if (searchInput) searchInput.value = \"\";\n  if (sortSelect) sortSelect.value = \"default\";\n\n  document.querySelectorAll('#filtersSidebar input[type=\"checkbox\"]').forEach((box) => {\n    box.checked = false;\n  });\n\n  applySearchFiltersAndSort();\n}\n","Overwrite":true,"Path":"C:\\Users\\User\\OneDrive\\Desktop\\CarVault project\\js\\explore.js"}},{"name":"write_file","args":{"Content":"/* ==========================================================================\n   CAR VAULT — Car Details Page Logic (js/car-details.js)\n   Loads the selected car from URL ?id=..., manages gallery thumbnails,\n   wishlist toggle, monthly installment estimator, and the BOOK button.\n   ========================================================================== */\n\nlet activeCar = null;\n\ndocument.addEventListener(\"DOMContentLoaded\", () => {\n  const params = new URLSearchParams(window.location.search);\n  const carId = params.get(\"id\") || \"honda-civic\";\n  activeCar = getCarById(carId);\n\n  renderCarDetails(activeCar);\n  setupInstallmentEstimator();\n\n  document.getElementById(\"bookTestDriveBtn\").addEventListener(\"click\", () => {\n    openBookingModal(activeCar.id);\n  });\n\n  document.getElementById(\"wishlistToggleBtn\").addEventListener(\"click\", () => {\n    toggleWishlistItem(activeCar.id);\n    updateWishlistButtonState();\n  });\n\n  document.addEventListener(\"carvault:wishlist-updated\", (event) => {\n    if (!event.detail || event.detail.carId === activeCar.id) {\n      updateWishlistButtonState();\n    }\n  });\n});\n\nfunction renderCarDetails(car) {\n  document.title = `${car.model} | CAR VAULT`;\n  document.getElementById(\"breadcrumbCarName\").textContent = car.model;\n  document.getElementById(\"carTitle\").textContent = car.model;\n  document.getElementById(\"carConditionBadge\").textContent = `${car.condition} \\u00B7 ${car.year}`;\n  document.getElementById(\"carPrice\").textContent = car.priceLabel;\n  document.getElementById(\"specEngine\").textContent = car.engine;\n  document.getElementById(\"specFuel\").textContent = car.fuel;\n  document.getElementById(\"specTransmission\").textContent = car.transmission;\n  document.getElementById(\"specType\").textContent = car.type;\n  document.getElementById(\"carDescription\").textContent = car.description;\n\n  const mainImage = document.getElementById(\"mainCarImage\");\n  mainImage.src = `../${car.image}`;\n  mainImage.alt = `${car.year} ${car.model} main view`;\n\n  const thumbsWrap = document.getElementById(\"galleryThumbs\");\n  const views = car.gallery && car.gallery.length ? car.gallery : [car.image];\n\n  thumbsWrap.innerHTML = views\n    .map(\n      (imgPath, index) => `\n      <button\n        type=\"button\"\n        class=\"thumb-btn ${index === 0 ? \"active\" : \"\"}\"\n        data-img=\"../${imgPath}\"\n        aria-label=\"View angle ${index + 1} of ${car.model}\"\n      >\n        <img src=\"../${imgPath}\" alt=\"${car.model} view ${index + 1}\">\n      </button>\n    `\n    )\n    .join(\"\");\n\n  thumbsWrap.querySelectorAll(\".thumb-btn\").forEach((thumb) => {\n    thumb.addEventListener(\"click\", () => {\n      mainImage.src = thumb.dataset.img;\n      thumbsWrap.querySelectorAll(\".thumb-btn\").forEach((b) => b.classList.remove(\"active\"));\n      thumb.classList.add(\"active\");\n    });\n  });\n\n  updateWishlistButtonState();\n}\n\nfunction updateWishlistButtonState() {\n  const btn = document.getElementById(\"wishlistToggleBtn\");\n  if (!btn || !activeCar) return;\n\n  const saved = isInWishlist(activeCar.id);\n  btn.classList.toggle(\"is-active\", saved);\n  btn.innerHTML = saved ? \"&#9829; Saved in Wishlist\" : \"&#9825; Wishlist\";\n}\n\nfunction setupInstallmentEstimator() {\n  const downSelect = document.getElementById(\"downPaymentSelect\");\n  const tenureSelect = document.getElementById(\"tenureSelect\");\n  const resultEl = document.getElementById(\"estimatedMonthly\");\n\n  function calculateMonthly() {\n    const downRatio = Number(downSelect.value);\n    const months = Number(tenureSelect.value) * 12;\n    const financedAmount = activeCar.price * (1 - downRatio);\n    const monthly = financedAmount / months;\n\n    resultEl.textContent = formatShortPkr(monthly) + \" / mo\";\n  }\n\n  downSelect.addEventListener(\"change\", calculateMonthly);\n  tenureSelect.addEventListener(\"change\", calculateMonthly);\n  calculateMonthly();\n}\n\nfunction formatShortPkr(amount) {\n  if (amount >= 10000000) {\n    return `Rs. ${(amount / 10000000).toFixed(2)} Cr`;\n  }\n  if (amount >= 100000) {\n    return `Rs. ${(amount / 100000).toFixed(2)} Lac`;\n  }\n  return `Rs. ${Math.round(amount).toLocaleString(\"en-PK\")}`;\n}\n","Overwrite":true,"Path":"C:\\Users\\User\\OneDrive\\Desktop\\CarVault project\\js\\car-details.js"}},{"name":"invoke_subagent","args":{"Model":"inherit","Prompt":"Generate a realistic studio/showroom photograph of a 2026 BMW M5 luxury sports sedan in metallic dark sapphire blue, front three-quarter angle in a clean modern dark-slate and warm-lit dealership showroom, crisp studio reflections, 16:9 aspect, no text or watermarks. Save it to artifact directory.","Role":"BMW M5 Image Generator","TypeName":"image-generator"}},{"name":"invoke_subagent","args":{"Model":"inherit","Prompt":"Generate a realistic studio/showroom photograph of a 2026 Audi A6 executive luxury sedan in sleek glacier white, front three-quarter angle inside a clean modern car dealership showroom, crisp realistic automotive photography, 16:9 aspect, no text or watermarks. Save it to artifact directory.","Role":"Audi A6 Image Generator","TypeName":"image-generator"}},{"name":"invoke_subagent","args":{"Model":"inherit","Prompt":"Generate a realistic studio/showroom photograph of a 2026 Kia Sportage modern crossover SUV in metallic gravity grey, front three-quarter angle inside a clean modern car dealership showroom, crisp realistic automotive photography, 16:9 aspect, no text or watermarks. Save it to artifact directory.","Role":"Kia Sportage Image Generator","TypeName":"image-generator"}}]}
