: 14400000,\n    priceLabel: \"Rs. 1.44 Cr\",\n    type: \"Pickup truck\",\n    engine: \"2800cc Turbo Diesel\",\n    fuel: \"Diesel\",\n    transmission: \"Automatic\",\n    featured: false,\n    image: \"images/cars/toyota-hilux.png\",\n    gallery: [\n      \"images/cars/toyota-hilux.png\",\n      \"images/cars/interior-cabin.png\",\n      \"images/cars/suv-rear-view.png\"\n    ],\n    description:\n      \"Tough 4x4 double-cabin pickup truck engineered for heavy-duty utility, mountain touring, and commanding road presence.\"\n  }\n];\n","Overwrite":true,"Path":"C:\\Users\\User\\OneDrive\\Desktop\\CarVault project\\js\\cars-data.js"}}]}
