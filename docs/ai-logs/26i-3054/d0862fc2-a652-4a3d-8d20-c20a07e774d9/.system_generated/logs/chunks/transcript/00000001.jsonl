 } catch (error) {\\n    return [];\\n  }\\n}\\n\\nfunction showToast(message) {\\n  const existing = document.querySelector(\\\".toast\\\");\\n  if (existing) {\\n    existing.remove();\\n  }\\n  const toast = document.createElement(\\\"div\\\");\\n  toast.className = \\\"toast\\\";\\n  toast.textContent = message;\\n  document.body.appendChild(toast);\\n  setTimeout(() => {\\n    toast.remove();\\n  }, 2600);\\n}\\n\\n/* ---------- Shared Car Card Renderer ---------- */\\nfunction buildCa\n<truncated 19058 bytes>","Overwrite":"true","Path":"\"C:\\\\Users\\\\User\\\\OneDrive\\\\Desktop\\\\CarVault project\\\\js\\\\common.js\""}},{"name":"write_file","args":{"Content":"\"/* ==========================================================================\\n   CAR VAULT — Home Page Logic (js/home.js)\\n   Renders the 2 featured cars (BMW M5 & Mercedes C400) and popular brand shortcuts.\\n   ========================================================================== */\\n\\ndocument.addEventListener(\\\"DOMContentLoaded\\\", () => {\\n  renderFeaturedCars();\\n  renderPopularBrands();\\n\\n  // Keep card wishlist buttons synced if changed inside the Saved Cars modal\\n  document.addEventListener(\\\"carvault:wishlist-updated\\\", () => {\\n    renderFeaturedCars();\\n  });\\n});\\n\\nfunction renderFeaturedCars() {\\n  const grid = document.getElementById(\\\"featuredCarsGrid\\\");\\n  if (!grid) return;\\n\\n  const featuredCars = CAR_VAULT_CARS.filter((car) => car.featured);\\n  grid.innerHTML = featuredCars.map(buildCarCardHtml).join(\\\"\\\");\\n  attachCardWishlistListeners(grid);\\n}\\n\\nfunction renderPopularBrands() {\\n  const strip = document.getElementById(\\\"popularBrandsStrip\\\");\\n  if (!strip) return;\\n\\n  const brands = [\\\"Toyota\\\", \\\"Honda\\\", \\\"Kia\\\", \\\"Audi\\\", \\\"BMW\\\", \\\"Mercedes-Benz\\\"];\\n  strip.innerHTML = brands\\n    .map(\\n      (brand) => `\\n      <a href=\\\"pages/explore-cars.html?brand=${encodeURIComponent(brand)}\\